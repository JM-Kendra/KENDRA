/data/
/documents/
/document-repository/
/intake/
/uploads/

# Databases and local state
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.duckdb

# Vector stores and search indexes
/indexes/
/vector-indexes/
/chroma/
/qdrant_storage/
/lancedb/
*.faiss
*.hnsw

# Models and model weights
/models/
*.safetensors
