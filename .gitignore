# Generated evaluation output (case definitions remain tracked)
/evaluation/artifacts/
/evaluation/reports/
/evaluation/results/
# EXP-11's evidence packets (Amendment A1(a)) are load-bearing for every future
# Stage 0/Stage 1 run, not one run's own ephemeral output -- tracked so they
# survive and stay auditable across commits, unlike the rest of /evaluation/runs/.
/evaluation/runs/*
!/evaluation/runs/EXP-11/
/evaluation/runs/EXP-11/*
!/evaluation/runs/EXP-11/packets/

