# Kendra Milestone 9 local-development defaults.
# Copy this file to .env. Never commit .env or place real credentials here.

# Application
KENDRA_ENVIRONMENT=development
KENDRA_LOG_LEVEL=INFO
KENDRA_API_HOST=0.0.0.0
KENDRA_API_BIND_HOST=127.0.0.1
KENDRA_API_PORT=8000
KENDRA_WEB_BIND_HOST=127.0.0.1
KENDRA_WEB_PORT=3000
KENDRA_CORS_ORIGINS=["http://127.0.0.1:3000"]
KENDRA_READINESS_TIMEOUT_SECONDS=3

# PostgreSQL. This password is a disposable local-only default; replace it in .env.
KENDRA_POSTGRES_HOST=postgres
KENDRA_POSTGRES_PORT=5432
KENDRA_POSTGRES_DATABASE=kendra
KENDRA_POSTGRES_USER=kendra
KENDRA_POSTGRES_PASSWORD=kendra-local-only-change-me

# Qdrant and Ollama stay on the private Compose network.
KENDRA_QDRANT_URL=http://qdrant:6333
KENDRA_QDRANT_API_KEY=
KENDRA_OLLAMA_URL=http://ollama:11434

# The host path may be a local folder now or an approved NAS mount later.
# The API always sees the stable container path and mounts it read-only.
KENDRA_DOCUMENT_STORE_HOST_PATH=./document-repository
KENDRA_DOCUMENT_STORE_ROOT=/documents

# One-off ingestion only. The running API never receives this mount.
KENDRA_INGESTION_INTAKE_HOST_PATH=./intake
KENDRA_INGESTION_INTAKE_ROOT=/intake
KENDRA_DOCLING_ARTIFACTS_PATH=/models/docling
KENDRA_PDF_MAX_BYTES=52428800
KENDRA_PDF_MAX_PAGES=500
KENDRA_MINIMUM_PAGE_TEXT_CHARS=40
KENDRA_EXTRACTION_COMPLETENESS_POLICY=native-primary-detection-v1
# KENDRA_PIPELINE_REVISION was removed here (Milestone 13 round 6) -- no code
# path ever read it (confirmed round 5, v16.md Task 1). The real provenance
# input is KENDRA_SOURCE_REVISION, exported by the operator before invoking
# ingestion (README.md's ingestion instructions); the ingest service already
# passes it through to resolve_source_revision(). Not repeated here as a
# blank template line since it is not meant to live in a long-lived .env --
# it is set once per invocation, at the shell, immediately before ingesting.
KENDRA_EXTRACTION_CANDIDATE_MINIMUM_AGREEMENT=0.90
KENDRA_CHUNK_SIZE_CHARS=1200
KENDRA_CHUNK_OVERLAP_CHARS=200
KENDRA_INGESTION_TOOL_TIMEOUT_SECONDS=300
KENDRA_EMBEDDING_MODEL=bge-m3
KENDRA_EMBEDDING_BATCH_SIZE=16
KENDRA_QDRANT_COLLECTION_PREFIX=kendra_ingestion

# Milestone 12. The API container is read-only with no .git mounted, so the
# revision must be injected from the host that builds/runs it:
#   export KENDRA_SOURCE_REVISION=$(git rev-parse HEAD)
# Leaving this unset resolves to "unknown" rather than a fabricated commit id.
KENDRA_SOURCE_REVISION=
KENDRA_SOURCE_REVISION_DIRTY=false

# Milestone 13. Only meaningful for a tagged release build; leave unset for
# ordinary development. `make build` sets this automatically when HEAD is
# exactly tagged (git describe --tags --exact-match), never by hand-editing.
KENDRA_RELEASE_TAG=

# Milestone 10 answering — prototype, unaccepted. Off by default; an unconfigured
# API abstains rather than answers. See docs/milestones/M12_STATUS.md.
KENDRA_ANSWERING_ENABLED=false
KENDRA_ANSWER_MODEL=qwen2.5:7b-instruct
KENDRA_ANSWER_TIMEOUT_SECONDS=120
KENDRA_RETRIEVAL_TOP_K=8
KENDRA_RETRIEVAL_SCORE_THRESHOLD=0.5

# Browser-visible loopback API URL, compiled into the Next.js frontend.
NEXT_PUBLIC_KENDRA_API_BASE_URL=http://127.0.0.1:8000

# Milestone 13. Web footer commit, compiled into the Next.js frontend at build
# time. `make build` sets this automatically from git rev-parse HEAD.
NEXT_PUBLIC_KENDRA_GIT_COMMIT=
