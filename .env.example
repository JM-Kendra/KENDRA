# Safe local-development defaults only. Copy to .env and change locally.
KENDRA_ENV=development
KENDRA_HOST=127.0.0.1
KENDRA_PORT=8000

# Runtime data belongs outside Git. These paths are ignored by default.
KENDRA_DOCUMENT_REPOSITORY=./document-repository
KENDRA_DATABASE_PATH=./data/kendra.sqlite3
KENDRA_VECTOR_INDEX_PATH=./vector-indexes
KENDRA_MODEL_PATH=./models

# Never place credentials or secret values in this template.
KENDRA_SECRET_KEY=
